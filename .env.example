# Ligar consulta espacial no Oracle (false = usa polígonos do mapa ORDS)
USE_ORACLE=false

# Easy Connect — usado se a tabela ORDS conexao_banco estiver vazia
ORACLE_USER=SEU_USUARIO
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=HOST:1521/SERVICE_NAME

# Credenciais de gravação, exclusivas do servidor
ORACLE_GRAVACAO_USER=
ORACLE_GRAVACAO_PASSWORD=
ORACLE_PERDAS_USER=
ORACLE_PERDAS_PASSWORD=
ORDS_CONEXAO_BANCO_URL=https://SEU_HOST/ords/SEU_SCHEMA/conexao_banco
ORDS_USER=
ORDS_PASSWORD=

# Token da conta ngrok que reservou o domínio HTTPS
NGROK_AUTHTOKEN=

# Este banco on-prem usa verificador de senha antigo: precisa do Instant Client (modo Thick).
ORACLE_USE_THICK=true
ORACLE_INSTANT_CLIENT=C:\instantclient-basic-windows.x64-23.26.0.0.0\instantclient_23_0

# Porta local da API REST
API_PORT=3001

# Porta do agente ngrok neste PC (http://127.0.0.1:PORTA/api/tunnels). Padrão 4040.
NGROK_API_PORT=4040

# URL HTTPS reservada do ngrok (o celular usa esta, não a LAN)
PUBLIC_API_URL=https://SEU_DOMINIO.ngrok-free.dev

# Cadastro de usuários e permissões (credenciais somente no servidor)
ORDS_AUTH_USUARIOS_URL=https://SEU_HOST/ords/SEU_SCHEMA/usuario_api
ORDS_AUTH_TOKEN=
AUTH_ALLOW_LEGACY_SHA256=false
ORDS_ACESSO_ABA_URL=https://SEU_HOST/ords/SEU_SCHEMA/app_acesso_aba
ORDS_ACESSO_ABA_TOKEN=

# Integração opcional com ControleAgricola
CONTROLE_AGRICOLA_TRANSPORTE=arquivo
CONTROLE_AGRICOLA_DB_PATH=C:\ControleAgricola\PlanejamentoAgricola\data\planejamento.db
CONTROLE_AGRICOLA_URL=
CONTROLE_AGRICOLA_INTEGRACAO_TOKEN=
